# Local runs and credentials
/logs/
/outputs/
/tmp/
/.workbuddy/
.env
.env.*
!.env.example

# Isolated runtime: retain the documented requirement snapshot
/runtime/*
!/runtime/README.md
!/runtime/.venv/
/runtime/.venv/*
!/runtime/.venv/requirements.txt

# Dependencies and generated build output
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
.DS_Store
Thumbs.db

# Local helper and root-level payloads
/git-push.ps1
/en_*.json
/request*.json

# User-supplied tools; keep only their public usage notice
/.agents/skills/en-writing-master/tools/*
!/.agents/skills/en-writing-master/tools/README.md

# Local backup, draft skills, and retired application
/.agents/.backup/
/.agents/skills/beta-*/
/applications/交互式学习/

# Root-only scratch directories; nested skill tests/examples are source files
/tests/
/examples/

# Downloaded dictionary resources; configured sources and attribution remain tracked
/dictionaries/resources/*.csv
/dictionaries/resources/*.gz
/dictionaries/resources/*.download
