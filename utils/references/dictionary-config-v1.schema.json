{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surfaceRaised": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "mutedText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "hover": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "selected": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "disabled": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "surfaceRaised",
        "text",
        "mutedText",
        "border",
        "hover",
        "selected",
        "disabled",
        "error",
        "success"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entry": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "candidate": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "outside": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "entry",
            "candidate",
            "outside"
          ]
        },
        "browsing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wordlistGroupSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "maxNodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "focusNeighbors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "expandedNeighbors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "wordlistGroupSize",
            "maxNodes",
            "focusNeighbors",
            "expandedNeighbors"
          ]
        },
        "initializeOnEnter": {
          "type": "boolean"
        },
        "family": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "synonym": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "near_synonym": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "antonym": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "spelling_similar": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "synonym",
            "near_synonym",
            "antonym",
            "spelling_similar"
          ]
        },
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "springStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "repulsionStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "familyNonMemberRepulsionStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "damping": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "restLength": {
              "type": "number",
              "minimum": 30,
              "maximum": 500
            },
            "familyNodeGap": {
              "type": "number",
              "minimum": 0,
              "maximum": 64
            }
          },
          "required": [
            "springStrength",
            "repulsionStrength",
            "familyNonMemberRepulsionStrength",
            "damping",
            "restLength",
            "familyNodeGap"
          ]
        }
      },
      "required": [
        "nodes",
        "browsing",
        "initializeOnEnter",
        "family",
        "relations",
        "physics"
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryAction": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primaryActionHover": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primaryActionPressed": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "activeText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "inactiveText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focus": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "sliderTrack": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "primaryAction",
        "primaryActionHover",
        "primaryActionPressed",
        "activeText",
        "inactiveText",
        "focus",
        "sliderTrack"
      ]
    },
    "favorites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "star": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "star"
      ]
    },
    "wordlists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "txt",
              "json",
              "jsonl"
            ]
          }
        }
      },
      "required": [
        "directory",
        "formats"
      ]
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wordsPerPage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pageSizeOptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "required": [
        "wordsPerPage"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "ui",
    "graph",
    "controls",
    "favorites",
    "wordlists",
    "study"
  ]
}
